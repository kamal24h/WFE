<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WFE.Core\WFE.Core.csproj" />
    <ProjectReference Include="..\WFE.Models\WFE.Models.csproj" />
    <ProjectReference Include="..\WFE.Runtime\WFE.Runtime.csproj" />
    <ProjectReference Include="..\WFE.Persistence\WFE.Persistence.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Concrete provider decided here since WFE.Persistence deliberately stays
         provider-agnostic. Swap for Npgsql.EntityFrameworkCore.PostgreSQL etc. if you'd
         rather use a different database - nothing elsewhere in the solution assumes SQL Server. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.10">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Pins the version NuGet should use across the whole graph - WFE.Runtime brings in
         Microsoft.CodeAnalysis.Common 4.8.0 (via Microsoft.CodeAnalysis.CSharp, for
         CodeActionCompiler), while EntityFrameworkCore.Design brings in 4.5.0 (via
         Microsoft.CodeAnalysis.CSharp.Workspaces) - without this explicit reference, NuGet
         can't pick a winner between two different top-level projects each pinning a different
         version of the same transitive package. -->
    <PackageReference Include="Microsoft.CodeAnalysis.Common" Version="4.8.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

</Project>
