{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=WFE;Trusted_Connection=True;TrustServerCertificate=True;"
  },

  "ActionExecutionPolicy": {
    "DefaultMaxRetries": 0,
    "DefaultRetryDelayMs": 0,
    "Overrides": {
      "HTTPRequest": { "MaxRetries": 1, "RetryDelayMs": 100 }
    }
  },

  "FileActions": {
    "RootPath": "wfe-files"
  },

  "WorkflowRuntime": {
    "MaxAutoHops": 10000
  },

  "SubprocessWorker": {
    "PollingIntervalMs": 500,
    "BatchSize": 20
  },

  "CodeActions": {
    "Enabled": false
  },

  "ScheduleWorker": {
    "PollingIntervalMs": 1000,
    "BatchSize": 50,
    "RetryIntervalSecondsIfNotFired": 30
  }
}
