<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>disable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\WFE.Core\WFE.Core.csproj" />
		<ProjectReference Include="..\WFE.Models\WFE.Models.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- No concrete DB provider referenced yet (SqlServer vs PostgreSQL vs other not decided).
         Add ONE of these before this project will build, e.g.:
           <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.10" />
           <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.10" />
         Also add Microsoft.EntityFrameworkCore.Design if you want `dotnet ef migrations add`
         to work from this project. -->
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.10" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.10" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.10" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.10">
		  <PrivateAssets>all</PrivateAssets>
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

</Project>
