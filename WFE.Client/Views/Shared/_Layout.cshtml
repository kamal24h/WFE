<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>WFE Client - Evaluation Harness</title>
    <style>
        body { font-family: -apple-system, Segoe UI, Arial, sans-serif; margin: 2rem; color: #1a1a1a; background: #fafafa; }
        h1 { font-size: 1.4rem; }
        .panel { background: #fff; border: 1px solid #ddd; border-radius: 6px; padding: 1rem 1.25rem; margin-bottom: 1.25rem; }
        .panel dl { display: grid; grid-template-columns: 160px 1fr; gap: 0.25rem 1rem; margin: 0; }
        .panel dt { color: #666; }
        table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
        th, td { text-align: left; padding: 0.4rem 0.6rem; border-bottom: 1px solid #eee; vertical-align: top; }
        th { color: #666; font-weight: 600; }
        .ok { color: #157347; }
        .fail { color: #b02a37; }
        .badge { display: inline-block; padding: 0.1rem 0.5rem; border-radius: 4px; font-size: 0.8rem; background: #eee; }
        input[type=text] { padding: 0.4rem; border: 1px solid #ccc; border-radius: 4px; margin-right: 0.5rem; }
        button { padding: 0.4rem 0.9rem; border: 0; border-radius: 4px; background: #2563eb; color: #fff; cursor: pointer; }
        button:hover { background: #1d4ed8; }
    </style>
</head>
<body>
    @RenderBody()
</body>
</html>
