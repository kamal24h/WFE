@model DashboardViewModel

<h1>WFE Client — Evaluation Harness</h1>

<div class="panel">
    <dl>
        <dt>WFE engine API</dt><dd>@Model.WfeBaseUrl</dd>
        <dt>Target WfeSchemeId</dt><dd>@Model.WfeSchemeId <span style="color:#666">(a fresh WfeProcessScheme snapshot is created for every run)</span></dd>
        <dt>RabbitMQ broker</dt><dd>@Model.RabbitMqEndpoint (queue: <code>@Model.RabbitMqQueueName</code>)</dd>
        <dt>RabbitMQ subscription</dt>
        <dd>
            @if (Model.RabbitMqIsRunning)
            {
                <span class="badge ok">running</span>
            }
            else
            {
                <span class="badge">stopped</span>
            }
            <form asp-controller="RabbitMq" asp-action="Start" method="post" style="display:inline; margin-inline-start: 0.5rem;">
                <button type="submit" @(Model.RabbitMqIsRunning ? "disabled" : "")>Start</button>
            </form>
            <form asp-controller="RabbitMq" asp-action="Stop" method="post" style="display:inline">
                <button type="submit" style="background:#b02a37" @(!Model.RabbitMqIsRunning ? "disabled" : "")>Stop</button>
            </form>
        </dd>
        <dt>RabbitMQ auto-start</dt>
        <dd>
            @if (Model.RabbitMqAutoConnect)
            {
                <span class="badge ok">enabled — starts automatically on app boot</span>
            }
            else
            {
                <span class="badge">disabled — use the Start button above, or set RabbitMq:AutoConnect=true</span>
            }
        </dd>
        <dt>Test auto-advancer</dt>
        <dd>
            @if (Model.TestAutoAdvancerEnabled)
            {
                <span class="badge ok">enabled — Waiting instances get auto-advanced</span>
            }
            else
            {
                <span class="badge">disabled — Waiting instances need a manual command (Swagger or below)</span>
            }
        </dd>
    </dl>
</div>

<div class="panel">
    <h3>Send a test packet</h3>
    <p>Simulates a broker message without needing a real broker - the fastest way to see the engine respond.</p>
    <form asp-controller="Home" asp-action="SendTestPacket" method="post">
        <input type="text" name="tag" placeholder="Tag (e.g. Sensor001)" required />
        <input type="text" name="value" placeholder="Value (e.g. 42.5)" required />
        <button type="submit">Send</button>
    </form>
</div>

<div class="panel">
    <h3>Recent activity (@Model.RecentEntries.Count)</h3>
    @if (Model.RecentEntries.Count == 0)
    {
        <p>Nothing sent yet.</p>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th>Time (UTC)</th>
                    <th>Source</th>
                    <th>Device</th>
                    <th>Tag</th>
                    <th>Value</th>
                    <th>Result</th>
                    <th>Instance</th>
                    <th>ms</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var entry in Model.RecentEntries)
                {
                    <tr>
                        <td>@entry.TimestampUtc.ToString("HH:mm:ss.fff")</td>
                        <td>@entry.Source</td>
                        <td>@entry.DeviceId</td>
                        <td>@entry.Tag</td>
                        <td>@entry.Value</td>
                        @if (entry.Result.Success)
                        {
                            <td class="ok">
                                @entry.Result.Engine?.Status @@ @entry.Result.Engine?.Activity
                                @if (!string.IsNullOrEmpty(entry.Result.Engine?.FaultReason))
                                {
                                    <div class="fail">@entry.Result.Engine.FaultReason</div>
                                }
                            </td>
                            <td>#@entry.Result.Engine?.InstanceId</td>
                        }
                        else
                        {
                            <td class="fail">@entry.Result.ErrorMessage</td>
                            <td>—</td>
                        }
                        <td>@entry.Result.ElapsedMs</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
